digraph{graph [rankdir=LR, bgcolor="transparent", pad=0.2, nodesep=0.35, ranksep=0.45]; node [shape=box, style="rounded,filled", fillcolor="#e8f6f3", color="#18bc9c", fontname="Helvetica", fontsize=12, margin="0.18,0.1"]; edge [color="#555555", fontname="Helvetica", fontsize=10]; s[label="1. Adapt a structure\n(choose a scenario)"]; r[label="2. Record and\ntranscribe"]; p[label="3. Prompt for\nfeedback"]; f[label="4. Reflect\nand adapt"]; s->r->p->f; f->r[label="deliver it again", constraint=false];}