digraph{graph [rankdir=LR, bgcolor="transparent", pad=0.2, nodesep=0.35, ranksep=0.45]; node [shape=box, style="rounded,filled", fillcolor="#e8f6f3", color="#18bc9c", fontname="Helvetica", fontsize=12, margin="0.18,0.1"]; edge [color="#555555", fontname="Helvetica", fontsize=10]; a[label="Student disengagement,\npoor performance or\ndisruptive behaviour"]; b[label="Typical teacher reaction:\ndiagnose, explain, propose,\ninsist on compliance"]; c[label="Control"]; d[label="Lower intrinsic\nmotivation"]; a->b->c->d; d->a;}